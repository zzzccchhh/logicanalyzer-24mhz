##
## This file is part of the U3LogicAnalyzer project.
##
## NSIS installer script for the U3LogicAnalyzer Windows build.
##
## IMPORTANT:
##   - Keep this file pure ASCII (no UTF-8 / non-ANSI text) so makensis
##     does not fail with "Bad text encoding".
##   - Use RELATIVE paths only. NSIS 3.12 with "RequestExecutionLevel admin"
##     mishandles absolute-path "File" directives ("no files found").
##     makensis must be run from the build output directory (the directory
##     that contains LogicAnalyzer.exe, the DLLs, run.bat, decoders/ and a
##     copy of COPYING + icons/), so relative paths resolve correctly.
##

# Unicode installer.
Unicode true

# Include the "Modern UI" header.
!include "MUI2.nsh"

# --- Global stuff ------------------------------------------------------------

# Installer/product name.
Name "U3LogicAnalyzer"

# Filename of the installer executable.
OutFile "@OUTFILE@"

# Where to install the application.
InstallDir "$PROGRAMFILES64\U3LogicAnalyzer"
InstallDirRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\U3LogicAnalyzer" "InstallLocation"

# Request admin privileges.
RequestExecutionLevel admin

# Local helper definitions.
!define REGSTR "Software\Microsoft\Windows\CurrentVersion\Uninstall\U3LogicAnalyzer"

# --- MUI interface configuration ---------------------------------------------

# Use the following icon for the installer EXE file.
!define MUI_ICON "icons\pulseview.ico"

# Show a nice image at the top of each installer page.
!define MUI_HEADERIMAGE

# Don't automatically go to the Finish page so the user can check the log.
!define MUI_FINISHPAGE_NOAUTOCLOSE

# Upon "cancel", ask the user if he really wants to abort the installer.
!define MUI_ABORTWARNING

# Don't force the user to accept the license, just show it.
!define MUI_LICENSEPAGE_BUTTON $(^NextBtn)
!define MUI_LICENSEPAGE_TEXT_BOTTOM "Click Next to continue."

# --- MUI pages ---------------------------------------------------------------

# Show a nice "Welcome to the ... Setup Wizard" page.
!insertmacro MUI_PAGE_WELCOME

# Show the license of the project.
!insertmacro MUI_PAGE_LICENSE "COPYING"

# Allow the user to select a different install directory.
!insertmacro MUI_PAGE_DIRECTORY

# Perform the actual installation.
!insertmacro MUI_PAGE_INSTFILES

# Show a final "We're done, click Finish to close this wizard" message.
# Run the app and show a note about the CH375 driver.
!define MUI_FINISHPAGE_RUN "$INSTDIR\LogicAnalyzer.exe"
!define MUI_FINISHPAGE_RUN_TEXT "Run U3LogicAnalyzer now"
!define MUI_FINISHPAGE_TEXT "Setup has finished installing U3LogicAnalyzer.$\r$\n$\r$\nIf your CH32H417 device is not detected, please install the WCH CH375 driver first, then restart the application."
!insertmacro MUI_PAGE_FINISH

# Pages used for the uninstaller.
!insertmacro MUI_UNPAGE_WELCOME
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_UNPAGE_FINISH

# --- MUI language files ------------------------------------------------------

# Installer languages.
!insertmacro MUI_LANGUAGE "English"

# --- Default section ---------------------------------------------------------

Section "U3LogicAnalyzer (required)"
	# This section is gray (can't be disabled) in the component list.
	SectionIn RO

	# Install the files into the specified directory.
	SetOutPath "$INSTDIR"

	# License file.
	File "COPYING"

	# Main application.
	File "LogicAnalyzer.exe"

	# All runtime DLLs.
	File "*.dll"

	# run.bat launcher.
	File "run.bat"

	# Protocol decoders.
	File /r "decoders"

	# Generate the uninstaller executable.
	WriteUninstaller "$INSTDIR\Uninstall.exe"

	# Create a sub-directory in the start menu.
	CreateDirectory "$SMPROGRAMS\U3LogicAnalyzer"

	# Create a shortcut for the application.
	CreateShortCut "$SMPROGRAMS\U3LogicAnalyzer\U3LogicAnalyzer.lnk" \
		"$INSTDIR\LogicAnalyzer.exe" "" "$INSTDIR\LogicAnalyzer.exe" \
		0 SW_SHOWNORMAL "" "U3LogicAnalyzer"

	# Create a shortcut for the application in debug mode.
	CreateShortCut "$SMPROGRAMS\U3LogicAnalyzer\U3LogicAnalyzer (Debug).lnk" \
		"$INSTDIR\LogicAnalyzer.exe" "-l 5" "$INSTDIR\LogicAnalyzer.exe" \
		0 SW_SHOWNORMAL "" "U3LogicAnalyzer (debug log level)"

	# Create a shortcut for the uninstaller.
	CreateShortCut "$SMPROGRAMS\U3LogicAnalyzer\Uninstall U3LogicAnalyzer.lnk" \
		"$INSTDIR\Uninstall.exe" "" "$INSTDIR\Uninstall.exe" 0 \
		SW_SHOWNORMAL "" "Uninstall U3LogicAnalyzer"

	# Create registry keys for "Add/remove programs" in the control panel.
	WriteRegStr HKLM "${REGSTR}" "DisplayName" "U3LogicAnalyzer"
	WriteRegStr HKLM "${REGSTR}" "UninstallString" \
		"$\"$INSTDIR\Uninstall.exe$\""
	WriteRegStr HKLM "${REGSTR}" "InstallLocation" "$\"$INSTDIR$\""
	WriteRegStr HKLM "${REGSTR}" "DisplayIcon" \
		"$\"$INSTDIR\LogicAnalyzer.exe$\""
	WriteRegStr HKLM "${REGSTR}" "Publisher" "U3"
	WriteRegStr HKLM "${REGSTR}" "DisplayVersion" "@PV_VERSION_STRING@"
	WriteRegDWORD HKLM "${REGSTR}" "NoModify" 1
	WriteRegDWORD HKLM "${REGSTR}" "NoRepair" 1
SectionEnd

# --- Uninstaller section -----------------------------------------------------

Section "Uninstall"
	# Always delete the uninstaller first (yes, this really works).
	Delete "$INSTDIR\Uninstall.exe"

	# Delete the application and related files.
	Delete "$INSTDIR\LogicAnalyzer.exe"
	Delete "$INSTDIR\*.dll"
	Delete "$INSTDIR\run.bat"
	Delete "$INSTDIR\COPYING"

	# Delete all decoders.
	RMDir /r "$INSTDIR\decoders"

	# Delete the install directory.
	RMDir "$INSTDIR"

	# Delete the links from the start menu.
	Delete "$SMPROGRAMS\U3LogicAnalyzer\U3LogicAnalyzer.lnk"
	Delete "$SMPROGRAMS\U3LogicAnalyzer\U3LogicAnalyzer (Debug).lnk"
	Delete "$SMPROGRAMS\U3LogicAnalyzer\Uninstall U3LogicAnalyzer.lnk"

	# Delete the sub-directory in the start menu.
	RMDir "$SMPROGRAMS\U3LogicAnalyzer"

	# Delete the registry key(s).
	DeleteRegKey HKLM "${REGSTR}"
SectionEnd
